# OpenRouter key that pays the AI (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
# Upstash Redis (Vercel KV) for games, limits and counters; without it the dev server keeps everything in memory
KV_REST_API_URL=
KV_REST_API_TOKEN=
# the most AI money TypeAGame spends in one UTC day, in USD
GLOBAL_USD_DAY=20
# GitHub token that may write to the games repo (fine-grained, contents: read and write on typecade/games only)
GITHUB_TOKEN=
GITHUB_GAMES_REPO=typecade/games
SITE=https://typecade.app
